# 複製為 .env 後填入實際金鑰:cp .env.example .env
# .env 已列入 .gitignore,不會進版控;已存在的環境變數(export)優先於 .env。

# 公司環境(configs/company.yaml)
COMPANY_EMBEDDING_API_KEY=請填入公司 embedding API 金鑰
COMPANY_LLM_API_KEY=請填入公司 LLM 閘道金鑰
# 兩者相同時填一樣的值即可。

# Elasticsearch(選配;跑 -m es 整合測試或 company.yaml 時需要)
# ES_URL=http://localhost:9200

# 個人環境(選配)
# OPENAI_API_KEY=sk-...
